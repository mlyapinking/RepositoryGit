Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если КоличествоСуток = 0 И ЗначениеЗаполнено(ДатаВозврата) Тогда
		КоличествоСуток = Цел((ДатаВозврата - Договор.ДатаНачала) / 86400);
	КонецЕсли;

	Если ИтоговаяСумма = 0 Тогда
		ИтоговаяСумма = КоличествоСуток * ЦенаЗаСутки + ДопРасходы;
	КонецЕсли;

КонецПроцедуры
