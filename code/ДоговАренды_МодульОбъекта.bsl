// ============================================================
// Модуль объекта документа "ДоговАренды"
// Вставьте в модуль ОБЪЕКТА (не формы!) в конфигураторе 1С
// ============================================================
//
// При проведении договора — статус авто "Занят"
// При отмене проведения — статус авто "Свободен"
//
// Если Статус — перечисление, сначала добавьте значение "Занят"
// в перечисление статусов (рядом со "Свободен").
// ============================================================

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
        Возврат;
    КонецЕсли;
    
    УстановитьСтатусАвтомобиля(Автомобиль, "Занят");
    
КонецПроцедуры

Процедура ОбработкаОтменыПроведения(Отказ)
    
    Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
        Возврат;
    КонецЕсли;
    
    УстановитьСтатусАвтомобиля(Автомобиль, "Свободен");
    
КонецПроцедуры

Процедура УстановитьСтатусАвтомобиля(АвтомобильСсылка, ИмяСтатуса)
    
    АвтомобильОбъект = АвтомобильСсылка.ПолучитьОбъект();
    
    // --- Вариант 1: Статус — строка ---
    АвтомобильОбъект.Статус = ИмяСтатуса;
    
    // --- Вариант 2: Статус — перечисление (раскомментируйте, если у вас Перечисление) ---
    // Если ИмяСтатуса = "Занят" Тогда
    //     АвтомобильОбъект.Статус = Перечисления.СтатусыАвтомобилей.Занят;
    // ИначеЕсли ИмяСтатуса = "Свободен" Тогда
    //     АвтомобильОбъект.Статус = Перечисления.СтатусыАвтомобилей.Свободен;
    // КонецЕсли;
    
    АвтомобильОбъект.Записать();
    
КонецПроцедуры
