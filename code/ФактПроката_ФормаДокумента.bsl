// ============================================================
// Модуль формы документа "ФактПроката" (Закрытие аренды)
// Версия для учебной конфигурации (без общих модулей)
// ============================================================
//
// ВАЖНО! Не вставляйте весь файл целиком, если обработчики уже есть!
// 1С сама создаёт процедуры при привязке события "ПриИзменении".
// Если вставить код повторно — ошибка "уже определена".
//
// Правильный порядок:
// 1. Создайте обработчики через форму (события ПриИзменении).
// 2. В УЖЕ СУЩЕСТВУЮЩИЕ процедуры впишите одну строку вызова.
// 3. Добавьте только серверные процедуры (Заполнить... и Пересчитать...).
// ============================================================

// --- Обработчики событий (по одному экземпляру каждого!) ---

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
    ЗаполнитьДанныеПоДоговоруНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаВозвратаПриИзменении(Элемент)
    ПересчитатьСуммыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДопРасходыПриИзменении(Элемент)
    ПересчитатьСуммыНаСервере();
КонецПроцедуры

// --- Серверная логика ---

&НаСервере
Процедура ЗаполнитьДанныеПоДоговоруНаСервере()
    
    Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
        Объект.ЦенаЗаСутки = 0;
        Объект.КоличествоСуток = 0;
        Объект.ИтоговаяСумма = 0;
        Возврат;
    КонецЕсли;
    
    ДоговорОбъект = Объект.Договор.ПолучитьОбъект();
    Объект.ЦенаЗаСутки = ДоговорОбъект.ЦенаЗаСутки;
    
    Если НЕ ЗначениеЗаполнено(Объект.ДатаВозврата) Тогда
        Объект.ДатаВозврата = ДоговорОбъект.ДатаОкончания;
    КонецЕсли;
    
    ПересчитатьСуммыНаСервере();
    
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыНаСервере()
    
    Объект.КоличествоСуток = 0;
    Объект.ИтоговаяСумма = Объект.ДопРасходы;
    
    Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
        Возврат;
    КонецЕсли;
    
    ДоговорОбъект = Объект.Договор.ПолучитьОбъект();
    ДатаНачала = ДоговорОбъект.ДатаНачала;
    
    Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаВозврата) Тогда
        Возврат;
    КонецЕсли;
    
    РазницаДней = (НачалоДня(Объект.ДатаВозврата) - НачалоДня(ДатаНачала)) / 86400;
    Объект.КоличествоСуток = Макс(0, РазницаДней) + 1;
    Объект.ИтоговаяСумма = Объект.КоличествоСуток * Объект.ЦенаЗаСутки + Объект.ДопРасходы;
    
КонецПроцедуры
