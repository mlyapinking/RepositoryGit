&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
    ЗаполнитьДанныеПоДоговоруНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДатаВозвратаПриИзменении(Элемент)
    ПересчитатьСуммыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДопРасходыПриИзменении(Элемент)
    ПересчитатьСуммыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДоговоруНаСервере()
    
    Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
        Объект.ЦенаЗаСутки = 0;
        Объект.КоличествоСуток = 0;
        Объект.ИтоговаяСумма = 0;
        Возврат;
    КонецЕсли;
    
    // Цена фиксируется из договора аренды
    РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
        Объект.Договор, "ЦенаЗаСутки, ДатаНачала");
    
    Объект.ЦенаЗаСутки = РеквизитыДоговора.ЦенаЗаСутки;
    
    // Если дата возврата ещё не заполнена — подставим дату окончания из договора
    Если НЕ ЗначениеЗаполнено(Объект.ДатаВозврата) Тогда
        ДатаОкончания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
            Объект.Договор, "ДатаОкончания");
        Объект.ДатаВозврата = ДатаОкончания;
    КонецЕсли;
    
    ПересчитатьСуммыНаСервере();
    
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммыНаСервере()
    
    Объект.КоличествоСуток = 0;
    Объект.ИтоговаяСумма = Объект.ДопРасходы;
    
    Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
        Возврат;
    КонецЕсли;
    
    ДатаНачала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
        Объект.Договор, "ДатаНачала");
    
    Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаВозврата) Тогда
        Возврат;
    КонецЕсли;
    
    // Количество суток: разница дат + 1 (включая день выдачи)
    РазницаДней = (НачалоДня(Объект.ДатаВозврата) - НачалоДня(ДатаНачала)) / 86400;
    
    Если РазницаДней < 0 Тогда
        РазницаДней = 0;
    КонецЕсли;
    
    Объект.КоличествоСуток = РазницаДней + 1;
    Объект.ИтоговаяСумма = Объект.КоличествоСуток * Объект.ЦенаЗаСутки + Объект.ДопРасходы;
    
КонецПроцедуры

